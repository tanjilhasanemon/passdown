# Database connection string
# Local development (SQLite - default if omitted):
DATABASE_URL=sqlite:///./passdown.db

# Production (Supabase PostgreSQL Transaction Pooler on Vercel):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Allowed CORS origins for local development (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication settings (Beta v0.2.0 - NFR-13)
# Generate a strong secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=passdown-dev-secret-key-change-in-production-at-least-32-chars
JWT_EXPIRE_MINUTES=60

# Initial Admin Seed Credentials (used by backend/scripts/seed_admin.py - FR-41)
ADMIN_NAME=PassDown Admin
ADMIN_EMAIL=admin@passdown.edu
ADMIN_PASSWORD=Admin1234
