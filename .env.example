# Database connection string
# Local development (SQLite - default if omitted):
DATABASE_URL=sqlite:///./passdown.db

# Production (Supabase PostgreSQL Transaction Pooler on Vercel):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Allowed CORS origins for local development (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173